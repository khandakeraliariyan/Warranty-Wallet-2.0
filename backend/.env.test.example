NODE_ENV=test
ENABLE_TEST_AUTH=true

# Required. The database name must contain "test" or the harness refuses to run.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warranty_wallet_test

# Prisma commands read DATABASE_URL. Set it to the same isolated test database
# when applying migrations before the suite.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warranty_wallet_test

CLIENT_URL=http://localhost:3000

# Unit and integration payment tests mock provider calls. This non-secret value
# only allows Stripe's SDK configuration module to initialize.
STRIPE_SECRET_KEY=sk_test_integration_placeholder

# AI provider calls are mocked or excluded from database workflow suites.
GEMINI_API_KEY=integration-placeholder
